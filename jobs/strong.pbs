#!/bin/bash
#PBS -N gemm2d_strong
#PBS -o results/strong.out
#PBS -e results/strong.err
#PBS -q short_cpuQ
#PBS -l walltime=2:00:00
#PBS -l select=4:ncpus=32:mpiprocs=32:mem=64gb

# E3 -- strong scaling: fixed problem, growing P.
cd "$PBS_O_WORKDIR" || exit 1
. jobs/env.sh

make clean && make || exit 1

export OMP_NUM_THREADS=1
export OMP_PROC_BIND=close
export OMP_PLACES=cores

# REP is the OUTER loop on purpose. The benchmarking lecture (Hoefler &
# Belli) asks for configurations to be interleaved rather than run
# back-to-back, so that cluster drift does not correlate with the
# independent variable. Running all reps of NP=1 first and all reps of
# NP=128 last would do exactly that.
#
# Note on the baseline: speedup below is reported against this code at
# NP=1, which is a serial baseline, not the best-known single-node time.
# State that in the report -- S9 warns against inflating speedup.
N=8192
for REP in $(seq 1 10); do
  for NP in 1 2 4 8 16 32 64 128; do
    mpiexec -n $NP --map-by core --bind-to core \
      ./gemm2d --M $N --N $N --K $N --engine summa --b 256 \
               --verify freivalds --reps 1 --warmup 1 --quiet \
               --tag strong --csv results/strong.csv
  done
done
